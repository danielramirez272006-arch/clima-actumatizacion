            },
            {
              "name": "message",
              "value": "Se recomienda reprogramar la actividad por condiciones climáticas adversas"
            }
          ]
        }
      },
      "id": "7k9h4i7i-0h8g-7i1j-4l5g-7h8i9j0k1l2m",
      "name": "Set - Reprogramar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1060, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/evaluations",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"locationName\": \"San José, Costa Rica\",\n  \"status\": \"{{ $json.status }}\",\n  \"riskLevel\": \"{{ $json.riskLevel }}\",\n  \"temperature\": {{ $json.temperature }},\n  \"precipitation\": {{ $json.precipitation }},\n  \"windSpeed\": {{ $json.windSpeed }},\n  \"humidity\": {{ $json.humidity }},\n  \"message\": \"{{ $json.message }}\",\n  \"timestamp\": \"{{ $now.toISO() }}\",\n  \"source\": \"n8n_automation\"\n}",
        "options": {
          "neverError": true
        }
      },
      "id": "8l0i5j8j-1i9h-8j2k-5m6h-8i9j0k1l2m3n",
      "name": "Save to JSON-Server DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"{{ $('Switch - Routes').item.json.recomendacion }}\",\n  \"riskLevel\": \"{{ $('Switch - Routes').item.json.riskLevel }}\",\n  \"temperature\": {{ $('Switch - Routes').item.json.temperature_2m }},\n  \"precipitation\": {{ $('Switch - Routes').item.json.precipitation }},\n  \"windSpeed\": {{ $('Switch - Routes').item.json.wind_speed_10m }},\n  \"humidity\": {{ $('Switch - Routes').item.json.relative_humidity_2m }},\n  \"savedInDb\": true,\n  \"timestamp\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "9m1j6k9k-2j0i-9k3l-6n7i-9j0k1l2m3n4o",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
