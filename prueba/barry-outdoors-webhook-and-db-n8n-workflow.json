            },
            {
              "name": "message",
              "value": "Tome precauciones adicionales para realizar la actividad"
            }
          ]
        }
      },
      "id": "6j8g3h6h-9g7f-6h0i-3k4f-6g7h8i9j0k1l",
      "name": "Set - Precaución",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1060, 300]
    },
    {
      "parameters": {
