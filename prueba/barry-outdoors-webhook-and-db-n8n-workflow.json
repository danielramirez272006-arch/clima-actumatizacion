{
  "name": "Barry Outdoors - Webhook & DB Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "weather-evaluation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "weather-evaluation"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.open-meteo.com/v1/forecast?latitude=9.9981&longitude=-84.1169&current=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m",
        "options": {}
      },
      "id": "2f4c9d2d-5c3b-4d6e-9g0b-2c3d4e5f6g7h",
      "name": "HTTP Request - Open-Meteo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const current = $input.all()[0].json.current;\n\nconst temperature = current.temperature_2m;\nconst precipitation = current.precipitation;\nconst windSpeed = current.wind_speed_10m;\nconst humidity = current.relative_humidity_2m;\n\nlet recomendacion = \"Realizar\";\nlet riskLevel = \"Bajo\";\n\nif (temperature < 10 || temperature > 35 || precipitation > 2 || windSpeed > 30) {\n  recomendacion = \"Reprogramar\";\n  riskLevel = \"Crítico\";\n} else if ((temperature >= 10 && temperature <= 14) || (temperature >= 31 && temperature <= 35) || (precipitation >= 0.1 && precipitation <= 2) || (windSpeed >= 15 && windSpeed <= 30)) {\n  recomendacion = \"Precaución\";\n  riskLevel = \"Moderado\";\n}\n\nreturn {\n  recomendacion: recomendacion,\n  riskLevel: riskLevel,\n  temperature_2m: temperature,\n  precipitation: precipitation,\n  wind_speed_10m: windSpeed,\n  relative_humidity_2m: humidity\n};"
      },
      "id": "3g5d0e3e-6d4c-4e7f-0h1c-3d4e5f6g7h8i",
      "name": "Code Node - Business Rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": [
            {
              "condition": "equal",
              "leftValue": "={{ $json.recomendacion }}",
              "rightValue": "Realizar"
            },
            {
              "condition": "equal",
              "leftValue": "={{ $json.recomendacion }}",
              "rightValue": "Precaución"
            },
            {
              "condition": "equal",
              "leftValue": "={{ $json.recomendacion }}",
              "rightValue": "Reprogramar"
            }
          ]
        }
      },
      "id": "4h6e1f4f-7e5d-4f8g-1i2d-4e5f6g7h8i9j",
      "name": "Switch - Routes",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [840, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": "{{ $json.recomendacion }}"
            },
            {
              "name": "riskLevel",
              "value": "{{ $json.riskLevel }}"
            },
            {
              "name": "temperature",
              "value": "{{ $json.temperature_2m }}"
            },
            {
              "name": "precipitation",
              "value": "{{ $json.precipitation }}"
            },
            {
              "name": "windSpeed",
              "value": "{{ $json.wind_speed_10m }}"
            },
            {
              "name": "humidity",
              "value": "{{ $json.relative_humidity_2m }}"
            },
            {
              "name": "message",
              "value": "Puede realizar la actividad sin restricciones"
            }
          ]
        }
      },
      "id": "5i7f2g5g-8f6e-5g9h-2j3e-5f6g7h8i9j0k",
      "name": "Set - Realizar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1060, 150]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": "{{ $json.recomendacion }}"
            },
            {
              "name": "riskLevel",
              "value": "{{ $json.riskLevel }}"
            },
            {
              "name": "temperature",
              "value": "{{ $json.temperature_2m }}"
            },
            {
              "name": "precipitation",
              "value": "{{ $json.precipitation }}"
            },
            {
              "name": "windSpeed",
              "value": "{{ $json.wind_speed_10m }}"
            },
            {
              "name": "humidity",
